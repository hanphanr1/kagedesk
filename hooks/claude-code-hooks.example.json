{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/kagedesk-emit.ps1 -Type tool_start -AgentId claude -Message \"Tool execution started\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/kagedesk-emit.ps1 -Type tool_done -AgentId claude -Message \"Tool execution completed\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/kagedesk-emit.ps1 -Type notification -AgentId claude -Message \"Notification received\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/kagedesk-emit.ps1 -Type idle -AgentId claude -Message \"Agent stopped\""
          }
        ]
      }
    ]
  }
}
